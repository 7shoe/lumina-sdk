#!/usr/bin/env bash
#PBS -N opf-dd-pilot
#PBS -A EpiCalib
#PBS -q debug-scaling
#PBS -l select=32
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -m n
set -euo pipefail
source /home/siebenschuh/Projects/reasonABLE/env/Aurora/activate_reason_venv.sh
cd "${DD_SOURCE:?Set DD_SOURCE to the frozen source directory}"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
unset MPI4PY_RC_INITIALIZE RANK WORLD_SIZE LOCAL_RANK LOCAL_WORLD_SIZE MPI_LOCALRANKID SLURM_LOCALID PALS_LOCAL_RANKID
nodes=$(wc -l < "$PBS_NODEFILE")
if [[ ${DD_STAGE:-pilot} != pilot ]]; then
    mpiexec --pmi=pmix --envall -n 12 --ppn 12 --cpu-bind depth --depth 2 \
        python -u -m distillation.experiments.dd_pilot "${DD_STAGE}" --root "${DD_OUTPUT:?Set DD_OUTPUT}"
else
    mpiexec --pmi=pmix --envall -n "$((nodes * 12))" --ppn 12 --cpu-bind depth --depth 2 \
        python -u -m distillation.synthetic.campaign --manifest "${DD_OUTPUT:?Set DD_OUTPUT}/manifest.json" \
        --allocation-seconds 3300
fi
