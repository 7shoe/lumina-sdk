#!/usr/bin/env bash
#PBS -N lumina-t2
#PBS -A EpiCalib
#PBS -q debug-scaling
#PBS -l select=12
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -j oe
set -euo pipefail

source /home/siebenschuh/Projects/reasonABLE/env/Aurora/activate_reason_venv.sh
repo=/home/siebenschuh/Projects/lumina-sdk
cd "$repo"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 PYTHONUNBUFFERED=1
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export MPIR_CVAR_PROGRESS_TIMEOUT=0
unset MPI4PY_RC_INITIALIZE RANK WORLD_SIZE LOCAL_RANK MPI_LOCALRANKID SLURM_LOCALID PALS_LOCAL_RANKID

nodes=$(sort -u "$PBS_NODEFILE" | wc -l)
workers=${T2_PPN:-6}
if (( workers < 1 || workers > 6 )); then
    echo "T2_PPN must be between 1 and 6" >&2
    exit 1
fi
config=${T2_CONFIG:-$repo/distillation/training/T2_multi_topo/config.yaml}
mpiexec --pmi=pmix --envall -n "$nodes" --ppn 1 --cpu-bind depth --depth 1 \
    python -u -m distillation.training.warm_cache --config "$config"

mpiexec --pmi=pmix --envall -n "$((nodes * workers))" --ppn "$workers" --cpu-bind depth --depth 4 \
    python -u -m distillation.training.T2_multi_topo.campaign --mpi \
    --config "$config" \
    --seconds "${T2_SECONDS:-3300}"
